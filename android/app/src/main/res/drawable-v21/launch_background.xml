<?xml version="1.0" encoding="utf-8"?>
<!-- Shown before Flutter draws on Android 11 and older: the same small icon
     and empty bar as the app's startup screen (drawable-*nodpi/splash_logo,
     made by tool/make_icons.dart), on the app canvas colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_logo"
        android:gravity="center" />
</layer-list>
